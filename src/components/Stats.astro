---
/* The headline under the hero: what a decision maker takes away in five
 * seconds. Claims, not counts - the technical figures (tests, specs, gates)
 * belong to the framework's README, not to this page. */
const tiles = [
  ["0 €", "license fees - now and later, for any number of users"],
  ["1 class", "per app - no frontend project, no extra platform"],
  ["Minutes", "to a first screen, built by the ABAP team you have"],
  ["7.02 → Cloud", "every SAP release, from one source"],
  ["100 % yours", "open source, no vendor, no lock-in"],
];
---
<div class="stats wrap" aria-label="abap2UI5 at a glance">
  <ul>
    {tiles.map(([value, label]) => <li><b>{value}</b><span>{label}</span></li>)}
  </ul>
</div>
