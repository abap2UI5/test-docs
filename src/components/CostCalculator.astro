---
/* The cost calculator - once the manual's, now only here: set the
 * landscape, press Calculate, read off the sheet. Every line is zero, and the
 * page says why on each one.
 *
 * It works without its script: the sheet is in the page with the default
 * values, and /test-docs/calc.js (public/calc.js, a file of its own because the
 * policy allows scripts from this origin only, never inline) makes the sliders
 * speak, hides the sheet until Calculate and echoes the choices into it. */
const DOCS = "https://abap2ui5.github.io/docs/";
const base = import.meta.env.BASE_URL;
const sliders = [
  ["users", "Named users", "1|5|10|25|50|100|250|500|1000|2500|5000|10000|25000|50000|100000|250000", 6, "user|users"],
  ["systems", "Systems in the landscape", "1|2|3|4|5|6|8|10|12|15|20|30|50", 2, "system|systems"],
  ["apps", "Apps", "1|2|3|5|10|20|50|100|200|500|1000", 4, "app|apps"],
  ["developers", "Developers", "1|2|3|5|10|20|50|100|200|500", 3, "developer|developers"],
  ["roundtrips", "Load", "100|1000|10000|100000|1000000|10000000|100000000", 3, "roundtrip a day|roundtrips a day"],
  ["term", "Contract term", "1|2|3|5|10", 2, "year|years"],
];
const releases = [
  ["702", "NetWeaver 7.02"], ["731", "NetWeaver 7.31"], ["740", "NetWeaver 7.40"], ["750", "NetWeaver 7.50"],
  ["752", "NetWeaver 7.52"], ["s4-onprem", "S/4HANA on-premise"], ["s4-private", "S/4HANA Private Cloud"],
  ["btp", "BTP ABAP Environment"], ["s4-public", "S/4HANA Public Cloud"],
];
const label = (stops: string, at: number, unit: string) => {
  const n = Number(stops.split("|")[at]);
  const [one, many] = unit.split("|");
  return `${n.toLocaleString("en-US")} ${n === 1 ? one : many}`;
};
const echo = Object.fromEntries(sliders.map(([id, , stops, at, unit]) => [id, label(stops as string, at as number, unit as string)]));
const lines = [
  ["Framework license", "MIT, commercial use included", null],
  ["Per-user fee", ", and nobody is counting them", "users"],
  ["Per-system fee", ": abapGit pulls the same repository into each of them", "systems"],
  ["Per-app fee", ", each one a class in your own system", "apps"],
  ["Developer seats", ", with ADT, the playground and the VS Code extension", "developers"],
  ["Platform", ": the same class runs on every one of them, from 7.02 up", "release"],
  ["Runtime", ", every one of them served by your own ABAP stack", "roundtrips"],
  ["Frontend hosting", "the UI5 your system already ships, and no frontend deployment", null],
  ["Support", ": GitHub issues and Slack are open to everybody either way", "support"],
  ["Upgrades", " of releases, each one an abapGit pull", "term"],
];
const give = [
  ["Star the repository.", `One click on <a href="https://github.com/abap2UI5/abap2UI5">GitHub</a>, and the next visitor sees a project rather than an experiment.`],
  ["Answer somebody.", `One reply under an <a href="https://github.com/abap2UI5/abap2UI5/issues">issue</a> or in <a href="https://abapgit.slack.com/join/shared_invite/zt-46tqufaht-QlrxTzlDqlx85CWbeUnOqg#/shared-invite/email">Slack</a> saves somebody else an afternoon of searching.`],
  ["Report what broke.", `An <a href="https://github.com/abap2UI5/abap2UI5/issues">issue</a> with a class that reproduces the bug is half of the fix already.`],
  ["Post about it.", `A short post that mentions <a href="https://www.linkedin.com/company/abap2ui5">the page</a> and carries <b>#abap2UI5</b> is how the word gets around.`],
  ["Add your company.", `One row under <a href="#who-runs-it">Who runs it</a> is what answers <i>is anybody actually running this?</i>`],
  ["Sponsor the work.", `<a href="${DOCS}resources/sponsor">The contributors</a>, and the open-source projects it stands on - the smallest amount is a real one.`],
];
---
<div class="calc" data-calc>
  <div class="calc-inputs">
    {sliders.slice(0, 1).map(([id, text, stops, at, unit]) => (
      <div class="calc-row"><label for={`calc-${id}`}>{text}</label><input id={`calc-${id}`} type="range" min="0" max={String((stops as string).split("|").length - 1)} value={String(at)} data-stops={stops} data-unit={unit} data-key={id}><output for={`calc-${id}`} data-out={id}>{echo[id as string]}</output></div>
    ))}
    <fieldset class="calc-row calc-choices">
      <legend>Your systems</legend>
      <span>{releases.map(([v, t]) => <label><input type="checkbox" name="calc-release" value={v} data-choice={t} checked={v === "s4-onprem"}> {t}</label>)}</span>
    </fieldset>
    {sliders.slice(1, 5).map(([id, text, stops, at, unit]) => (
      <div class="calc-row"><label for={`calc-${id}`}>{text}</label><input id={`calc-${id}`} type="range" min="0" max={String((stops as string).split("|").length - 1)} value={String(at)} data-stops={stops} data-unit={unit} data-key={id}><output for={`calc-${id}`} data-out={id}>{echo[id as string]}</output></div>
    ))}
    <fieldset class="calc-row calc-choices">
      <legend>Support</legend>
      <span><label><input type="radio" name="calc-support" value="none" data-choice="No support"> No support</label><label><input type="radio" name="calc-support" value="community" data-choice="Community support" checked> Community support</label></span>
    </fieldset>
    {sliders.slice(5).map(([id, text, stops, at, unit]) => (
      <div class="calc-row"><label for={`calc-${id}`}>{text}</label><input id={`calc-${id}`} type="range" min="0" max={String((stops as string).split("|").length - 1)} value={String(at)} data-stops={stops} data-unit={unit} data-key={id}><output for={`calc-${id}`} data-out={id}>{echo[id as string]}</output></div>
    ))}
    <div class="calc-row"><label for="calc-currency">Currency</label><select id="calc-currency" data-currency>{["EUR", "USD", "GBP", "CHF", "INR", "JPY", "BRL", "AUD"].map((c) => <option value={c} selected={c === "EUR"}>{c}</option>)}</select></div>
    <p class="calc-actions"><button type="button" class="btn btn-primary" data-calculate data-again="Change the numbers">Calculate</button></p>
  </div>
  <div class="calc-result" data-result>
    <div class="calc-sheet">
      {lines.map(([what, note, key]) => (
        <div class="calc-line">
          <span class="calc-what">{what}<small>{key ? <><span data-echo={key}>{key === "release" ? "S/4HANA on-premise" : key === "support" ? "Community support" : echo[key as string]}</span>{note}</> : note}</small></span>
          <span class="calc-amount" data-amount>€0</span>
        </div>
      ))}
    </div>
    <div class="calc-total">
      <div><span>Total, over <span data-echo="term">{echo.term}</span></span><output data-amount>€0</output></div>
      <div><span>Per year</span><output data-amount>€0</output></div>
      <div><span>Per user, per month</span><output data-amount>€0</output></div>
      <p>The formula is short: every line is zero, and a sum of zeros is zero - no matter what you set. abap2UI5 is <a href={`${DOCS}resources/license`}>MIT licensed</a>, commercial use included, and what you build with it is a standard UI5 app served by the ABAP stack you already run.</p>
    </div>
  </div>
  <div class="calc-give" data-result>
    <h3>Free to use is not the same as free to make</h3>
    <p>Those zeros were written in somebody's evenings - the release you will pull next month, the answer under your issue, the 7.02 downport nobody asked for. That part of the bill is real; it is just not addressed to you. And it is payable in a currency you already have:</p>
    <ul>{give.map(([b, t]) => <li><b>{b}</b> <span set:html={t} /></li>)}</ul>
  </div>
</div>
<script is:inline type="module" src={`${base}calc.js`}></script>
