const ai = [
  ["spark", "One app, one file", "An AI writes the whole app as one ABAP class. No service, no frontend project, no deployment to generate and keep in sync."],
  ["code", "In the tools your team uses", "Plugins for Claude Code and GitHub Copilot, skills for any agent, and an AI Studio in the browser that builds an app from a description."],
