---
/* abap2UI5 for decision makers - IT management, product owners, architecture
 * boards: what it lets you build, who runs it, where it is the shorter path
 * and where it is not, what it costs and how to start.
 *
 * Written to be read in a few minutes: one claim per section, every claim
 * with the place it can be checked, and the downsides named next to the
 * upsides - a reader who finds the first one hidden stops believing the rest.
 *
 * THE SECTION IDS ARE ADDRESSES. /docs/evaluate redirects here with its
 * #fragment, and the framework's README links #what-you-keep and
 * #when-to-use-it-and-when-not; test/site.test.mjs names all eight, so a
 * renamed id is a failing build, not a dead link. */
import Page from "../layouts/Page.astro";
import Stats from "../components/Stats.astro";
import Icon from "../components/Icon.astro";
import CostCalculator from "../components/CostCalculator.astro";

const DOCS = "https://abap2ui5.github.io/docs/";
const PLAYGROUND = "https://abap2ui5.github.io/playground/";
const GITHUB = "https://github.com/abap2UI5/abap2UI5";
const GITHUB_PAGE = "https://github.com/abap2UI5/why";
const SLACK = "https://abapgit.slack.com/join/shared_invite/zt-46tqufaht-QlrxTzlDqlx85CWbeUnOqg#/shared-invite/email";
const MAIL = "contact@abap2UI5.org";
const base = import.meta.env.BASE_URL;

/* What it builds - the processes, not one feature. */
const useCases = [
  ["box", "Warehouse & logistics", "Goods receipt, picking, stock transfers and counts on scanners, handhelds and tablets, with the device's barcode scanner and camera.", "z2ui5_cl_smp_app_530", "A scan field for the warehouse: every scan lands in the list, no tap needed"],
  ["wrench", "Maintenance & service", "Work orders, notifications and checklists for technicians, in the workshop or at the machine.", "z2ui5_cl_smpc_app_089", "An object page: header, status and sections, as a work order would show them"],
  ["factory", "Production & shop floor", "Confirmations, quality inspections, shift plans and the special processes the standard never covered.", "z2ui5_cl_smpc_app_108", "A planning calendar, as a shift or capacity plan would use it"],
  ["check", "Approvals & workflows", "Purchase requisitions, invoices, leave and master-data requests: approve in one click, in the launchpad, in Teams or on the phone.", "z2ui5_cl_smpc_app_291", "A notification inbox with priorities and actions"],
  ["gauge", "Cockpits & dashboards", "KPIs, charts and monitors for one team or one process, live from SAP, without a data warehouse or a BI tool.", "z2ui5_cl_smpc_app_517", "Launchpad tiles with KPIs, trends and figures"],
  ["form", "Paper & Excel replaced", "Forms, checklists and spreadsheets that live outside SAP become apps that write straight into it.", "z2ui5_cl_smpc_app_329", "A form with an edit switch, instead of a paper form"],
  ["list", "SAP GUI modernized", "Reports, lists and transactions turn into browser apps one at a time, with the logic behind them unchanged.", "z2ui5_cl_smp_app_070", "A table with search, sort, filter and row actions"],
  ["phone", "Mobile, without an app store", "Every app runs on iOS and Android in the browser: nothing to install, nothing to distribute.", "z2ui5_cl_smpc_app_024", "A feed app on a phone"],
];

/* Who runs it. Only what a reader can check: the companies that said so,
 * and the figures GitHub shows. The figures are from October 2026. */
const companies = [
  ["Emineo", "https://emineo.ch/", "In production", "Apps for warehouse management and production, on desktop and mobile devices"],
  ["Swiss Krono", "https://www.swisskrono.com/", "In production", "Apps for warehouse management, on mobile devices"],
  ["Logali Group", "https://logaligroup.com", "Training", "Webinars and certifications for abap2UI5"],
];
const facts = [
  ["Since January 2023", "open source on GitHub, MIT licensed"],
  ["25+ contributors", "from several companies, every change public"],
  ["Release 1.148", "October 2026; a release most months, each one listed"],
  ["Every release tested", "on NetWeaver 7.02, Standard ABAP and ABAP Cloud, in the browser on the oldest and the newest UI5"],
];
/* The references a manager will recognize first; the full list folds. */
const references = [
  ["2026", "Field Service Management Mobile Logging using abap2UI5", "Decabase Blog", "https://blog.decabase.com/field-service-management-mobile-logging-using-abap2ui5-2c18e4ed455d"],
  ["2026", "Fiori-type Apps built 100% with ABAP", "Logali Group", "https://logaligroup.com/magia-en-el-servidor-local-apps-tipo-fiori-creadas-100-con-codigo-abap/"],
  ["2025", "Featured on SAP Developer News", "YouTube", "https://www.youtube.com/watch?v=vKrpkDe2mkU&list=PL6RpkC85SLQAVBSQXN9522_1jNvPavBgg&t=90s"],
  ["2024", "Highlighted in the Boring Enterprise Nerdletter", "YouTube", "https://www.youtube.com/watch?v=I81z6W_BTIA&t=1010s"],
  ["2023", "Showcased at SAP TechEd 2023", "YouTube", "https://www.youtube.com/watch?v=kLbF0ooStZs&t=3052s"],
  ["2023", "Part of the SAP Developer Code Challenge", "SAP Community", "https://groups.community.sap.com/t5/application-development/sap-developer-code-challenge-open-source-abap-week-2/m-p/260727#M1372"],
];
const moreReferences = [
  ["2026", "UI5 in ABAP Cloud (without RAP or Fiori Elements)", "Decabase Blog", "https://blog.decabase.com/ui5-in-abap-cloud-without-rap-or-fiori-elements-4e8a70d961c3"],
  ["2025", "Webinar on Launchpad Integration", "YouTube", "https://www.youtube.com/watch?v=t5g3F3PHsbw&list=PLLpkZ_86h4quGSfsjohDHt9CrpjXdeA1P"],
  ["2024", "Webinar on creating UI5 interfaces from ABAP using abap2UI5", "YouTube", "https://www.youtube.com/watch?v=N2OAdxf7Lng"],
  ["2024", "Webinar on developing UI5 apps with abap2UI5", "YouTube", "https://www.youtube.com/watch?v=0izPA2xrPPI"],
  ["2024", "Featured on SAP Developer News", "YouTube", "https://youtu.be/7n16u-Rx8IY?t=7"],
  ["2024", "Cust&Code Videos featuring abap2UI5", "YouTube", "https://www.youtube.com/watch?v=SD1vIt_ty0k"],
  ["2024", "Running abap2UI5 Backend in Browser", "LinkedIn", "https://www.linkedin.com/pulse/running-abap2ui5-backend-browser-lars-hvam-petersen-l8zff/?trackingId=4mhMb1v%2FSoa8SmDSiuCEpg%3D%3D"],
  ["2024", "Highlighted in the Boring Enterprise Nerdcast", "YouTube", "https://youtu.be/svDZKFBvqR8?t=1050"],
  ["2023", "Featured on SAP Developer News", "YouTube", "https://www.youtube.com/watch?v=CfH9L03WUCg&t=350s"],
  ["2023", "Join the Advent of Code 2023 with abap2UI5", "SAP Community", "https://blogs.sap.com/2023/11/27/preparing-for-advent-of-code-2023/"],
  ["2023", "Highlighted in the Boring Enterprise Nerdletter", "YouTube", "https://www.youtube.com/watch?v=G62exySitCo&list=PLlxj8-g1r2GlVYXVQnnV5izKwKtEn6KIp&t=1008s"],
  ["2023", "Featured on SAP Developer News", "YouTube", "https://www.youtube.com/watch?v=6BDK55xYttM"],
  ["2023", "See abap2UI5 on ABAP Open Source Projects", "dotabap.org", "https://dotabap.org/"],
];

/* The market, as a manager compares it: abap2UI5, SAP's own two routes, the
 * commercial UI5 app platforms and low-code builders sold on top of SAP.
 * A row where abap2UI5 is not ahead is marked `even`: it gets no tick. */
const rivals = ["RAP + Fiori Elements", "Freestyle UI5 + OData", "Commercial UI5 & low-code platforms"];
const compare = [
  ["License cost", "None: MIT, for any number of users, systems and apps", "Part of the SAP license", "Part of the SAP license", "Subscription or per-user fees, renewed every year"],
  ["Who builds the apps", "The ABAP team you already have", "ABAP plus CDS, RAP and annotation specialists", "JavaScript / UI5 developers", "Developers trained on the vendor's tool"],
  ["First screen", "Minutes", "Days: model, service, project, deployment", "Days to weeks", "After the platform is installed and licensed"],
  ["Freedom of the UI", "Every UI5 control, any layout", "SAP's floorplans and their extension points", "Every UI5 control", "What the vendor's designer offers"],
  ["Older SAP releases", "NetWeaver 7.02 up to ABAP Cloud, one source", "7.5x and later", "Yes, with OData effort per release", "Depends on the vendor's add-on"],
  ["Extra infrastructure", "None: one endpoint on your SAP system", "Fiori frontend server and deployment", "Frontend deployment (BSP, BTP or web server)", "The vendor's add-on, server or cloud tenant"],
  ["Lock-in", "None: apps are plain ABAP classes in your system", "SAP's programming model", "Low", "Apps live in the vendor's runtime and repository"],
  ["Source code", "Open, every line, on GitHub", "Closed", "UI5 open, your app yours", "Closed"],
  ["Standard transactional apps", "Possible, but hand-built; the standard route is RAP", "Its home ground: list report and object page from annotations", "Hand-built", "From the vendor's templates", "even"],
  ["Offline", "Not built for it: an app needs its connection to SAP", "Offline with extra tooling", "Possible, with effort", "Depends on the vendor", "even"],
  ["Support", "Slack and GitHub issues, open to anyone at any time; more by mail, planned together. No SLA in a contract", "SAP support", "SAP support for UI5; your app is yours", "The vendor's SLA, in the contract", "even"],
];
const useIt = [
  ["The team is ABAP.", "No JavaScript, no UI5 tooling, no Business Application Studio. An app is one class, written, debugged, transported and tested like every other class."],
  ["The system is older than RAP.", "NetWeaver 7.02 to 7.4x have no RAP and a Fiori stack that is expensive to add. An app written there today moves to S/4HANA unchanged."],
  ["The screen is yours, not SAP's.", "Tools, cockpits, monitors, admin consoles, anything that used to be a report or a module pool. Where a Fiori Elements template becomes the thing you fight, abap2UI5 is the shorter path."],
  ["Your Fiori apps and your logic stay.", "abap2UI5 apps are tiles in the same launchpad. A report, a BAPI, a function module: an app calls it as it is."],
];
const notIt = [
  ["You want the SAP standard transactional app.", "A list report with an object page on S/4HANA, from a released CDS model: RAP and Fiori Elements are the shorter path, and the one SAP supports."],
  ["The app must work offline.", "Every click is one request to the SAP system. A device that works without a network is not what it is for; live data on a connected screen is."],
  ["Your guideline mandates SAP's programming model.", "abap2UI5 is clean core in the technical sense, but it is not RAP. The usual outcome is a scope, not a replacement."],
  ["Your rules need an SLA on paper.", "Support happens in the open: anyone can write in the Slack channel or open an issue or a pull request on GitHub, at any time, and that is where answers come fastest. If you need more than that, write to the maintainers by mail and plan it together; what is not on offer is an SLA in a contract."],
];

/* Governance: an app is an ABAP class, against a tool that stores apps as
 * configuration, which is how the commercial builders work. */
const keep = [
  ["What an app is", "An ABAP class", "Entries in the tool's tables, read by its runtime"],
  ["Where a change is made", "In the development system, in the ABAP tools", "Wherever the tool's designer is open, possibly production"],
  ["How a change travels", "A transport, like any class", "The tool's own export, or a customizing transport"],
  ["How a change is reviewed", "As a code diff, in the transport or a pull request", "In the tool's designer, if it shows a history at all"],
  ["What happens if the tool goes away", "The classes stay; they are plain ABAP in your system", "The apps go with it"],
];
const governance = [
  ["lock", "Logon is SAP's", "No user store, no token, no session of its own. A request that reaches an app has passed SAP logon."],
  ["key", "Authorizations are SAP's", "The authorization on the service endpoint, as for any service, and the app's own checks in its code, as a transaction does them."],
  ["db", "Data changes are your code's", "An app posts a document through the same BAPIs, function modules or RAP actions as any other program, so change documents and application logs apply unchanged."],
  ["log", "Every request can be logged", "A monitor records, per request, the user, the app, the event, the timings and any error. Off until an installation switches it on."],
  ["leaf", "Clean core", "Released APIs only, passes the ABAP Cloud checks, runs on S/4HANA, BTP and NetWeaver 7.02 from one source. Modifies nothing in the SAP standard."],
];

/* What it costs: the lines a commercial platform bills, and what is left. */
const cost = [
  ["Framework license", "MIT, commercial use included, for any number of users, systems and apps", "0"],
  ["Platform, runtime, hosting", "One service on the SAP system you already run; the UI5 your system already ships", "0"],
  ["Support", "Slack and GitHub issues, open to anyone at any time; pull requests welcome", "0"],
  ["Developer time", "An ABAP developer writes the screen, as for any class; this is the bill", "your rate"],
  ["Training and consulting", "Webinars, certification, app development by a consultancy, if you want them", "optional"],
];
const strings = [
  ["Nothing to sign up for", "The examples run in the browser with no account. The framework is an abapGit pull; there is no trial period and no demo to book."],
  ["No extra platform", "No BTP subscription, no middleware, no server of its own. One service endpoint on the system you already run."],
  ["Free to leave", "The apps stay ordinary classes. A build renamed into your own namespace is one workflow run, and the source is yours to fork."],
  ["Built in the open", "Every issue, every release and the backlog are public on GitHub."],
];

/* AI: one class is one file an assistant can write whole and a reviewer can
 * read whole. Every claim is in the framework README's "Build with AI". */
const ai = [
  ["spark", "One app, one file", "An AI writes the whole app as one ABAP class. No service, no frontend project, no deployment to generate and keep in sync."],
  ["code", "In the tools your team uses", "Plugins for Claude Code and GitHub Copilot, skills for any agent, and an AI Studio in the browser that builds an app from a description."],
  ["check", "Checked before anyone looks", "The abap2UI5 linter tests every class the AI writes, and the AI fixes what it broke before a developer reviews it."],
];

const objections = [
  ["It is an open-source project. What if the maintainers stop?", `The installed version keeps running, the source is in your system in full, readable and changeable, and the apps stay ordinary ABAP classes. Nothing is called at runtime that is not in your system, apart from the UI5 library, which your system ships. A build renamed into your own namespace is one workflow run (<a href="${DOCS}advanced/renaming">Namespaces, Renaming</a>).`],
  ["Who do we call when something breaks?", `Your developer, for the app, as for any class in the system. For the framework, write in the <a href="${SLACK}">Slack channel</a> or open an <a href="${GITHUB}/issues">issue</a> on GitHub: anyone can, at any time, no account with the project needed, and in the open is where it gets answered fastest and where everybody sees the answer. Pull requests are welcome the same way. If your organization needs more, closer cooperation, a workshop or a support arrangement, write to <a href="mailto:${MAIL}">${MAIL}</a> and plan it together (<a href="${GITHUB}/blob/main/SUPPORT.md">Support</a>). Security reports are acknowledged within three business days (<a href="${DOCS}configuration/security">Security</a>).`],
  ["Is this another UI5 wrapper that will not survive the next UI5 release?", `The frontend is UI5 itself, not a copy of it, and every change is run in the browser on the oldest supported release and on UI5 2.x. Releases are tagged and listed (<a href="${DOCS}resources/changelog">Release Notes</a>); what is on its way out is announced and tracked until removal (<a href="${DOCS}resources/deprecations">Deprecations</a>).`],
  ["Every click is a request to SAP. Is that fast enough?", `A request carries only what changed and is served by the ABAP stack that already serves everything else. For worklists, forms and cockpits it is the same round trip a SAP GUI screen makes, in a browser. It is not built for an app that holds its state offline (<a href="${DOCS}configuration/performance">Performance</a>).`],
  ["Our clean-core guideline names RAP. Where does this leave us?", "Side by side. abap2UI5 passes the ABAP Cloud checks and modifies nothing in the standard, so it is clean core in the technical sense, but it is not SAP's programming model. The usual outcome is a scope: standard transactional screens in RAP, the tools around them in abap2UI5, both in one launchpad."],
  ["Why should we trust it over a product we pay for?", "Because you can check everything a vendor asks you to believe. The source is open, every test is public, and an app is a class in your own system that keeps running whatever happens to the project. What you do not get is an SLA in a contract; what you get is the code, and a maintainer you can reach."],
  ["Is anybody actually running this in production?", `Two companies say so on this page, and every release is tested against Standard ABAP and ABAP Cloud, downported to NetWeaver 7.02 and run in the browser on the oldest and the newest supported UI5 release (<a href="${GITHUB}/blob/main/docs/verified-on.md">verified on</a>).`],
];

/* Get started: one real screen, with the people who will maintain it. */
const week = [
  ["Pick one real screen", "One your team has to build this quarter, not a demo."],
  ["Build it in a development system", "With the people who will maintain it, in the ABAP tools they use today."],
  ["Review it like any ABAP", "Read the class, transport it, run the code checks, check the authorizations it asks for."],
  ["Compare and decide", "Hold the time and the systems it needed against any alternative or vendor quote. Decide from the screen, not from the slide."],
];
const doors = [
  ["play", "Ten minutes, nothing installed", "Browse the example apps for the screen closest to yours, and change one in the playground.", `${PLAYGROUND}samples/`, "Example apps"],
  ["code", "One afternoon, one developer", "Send them the Quickstart: install, first app, transport.", `${DOCS}get_started/quickstart`, "Quickstart"],
  ["chat", "A question, any time", "Write in the Slack channel, where the people who run it in production answer, or open a GitHub issue. Anyone can, at any time.", SLACK, "Slack"],
  ["partner", "More than a question", `A workshop, closer cooperation, a support arrangement: write to ${MAIL} and plan it together.`, `mailto:${MAIL}`, "Mail"],
];
const give = [
  ["Add your company.", `One row under <a href="#who-runs-it">Who runs it</a> is what answers <i>is anybody actually running this?</i> for the next reader.`],
  ["Report what broke.", `An <a href="${GITHUB}/issues">issue</a> with a class that reproduces the bug is half of the fix already.`],
  ["Sponsor the work.", `<a href="${DOCS}resources/sponsor">The contributors</a>, and the open-source projects it stands on.`],
];
---
<Page
  title="abap2UI5 · for decision makers"
  description="abap2UI5 for decision makers: what you can build with it, who runs it, where it is the shorter path to a UI5 app on SAP and where it is not, what it costs and how to start with one real screen."
>
  <section class="hero">
    <div class="wrap">
      <div>
        <h1>UI5 apps for SAP, built by <em>the team you already have</em></h1>
        <p class="lede">abap2UI5 lets ABAP developers build UI5 apps as one ABAP class: <b>no JavaScript, no extra platform, no license fee.</b> Open source since 2023, in production on the desktop and on the warehouse floor.</p>
        <div class="actions">
          <a class="btn btn-primary" href={`${PLAYGROUND}samples/`}>See example apps</a>
          <a class="btn btn-ghost" href="#when-to-use-it-and-when-not">Where it fits</a>
        </div>
        <p class="note">Nothing to install, nothing to sign up for: every example runs in your browser.</p>
      </div>
      <figure class="window">
        <div class="window-bar" aria-hidden="true"><i></i><i></i><i></i><span>an abap2UI5 app · one ABAP class</span></div>
        <img src={`${base}apps/z2ui5_cl_smp_app_070.webp`} alt="An abap2UI5 app: a search field above a table of products with progress indicators and row actions" width="800" height="500" fetchpriority="high">
      </figure>
    </div>
  </section>

  <Stats />

  <section class="section" id="the-problem-it-answers" aria-labelledby="h-build">
    <div class="wrap">
      <p class="kicker">What you can build</p>
      <h2 id="h-build">Every process in SAP that needs a screen</h2>
      <p class="intro">Whatever runs on paper, in Excel or in SAP GUI today becomes a browser app, built in your own system by your own team. Each card opens a running example.</p>
      <div class="cards four">
        {useCases.map(([icon, h, t, cls, alt]) => (
          <div class="card shot">
            <a class="shot-img" href={`${PLAYGROUND}samples/${cls}/`}><img src={`${base}apps/${cls}.webp`} alt={alt} width="800" height="500" loading="lazy"></a>
            <Icon name={icon} /><h3>{h}</h3><p>{t}</p>
            <a class="shot-link" href={`${PLAYGROUND}samples/${cls}/`}>See the example app</a>
          </div>
        ))}
      </div>
      <p class="more">→ Browse the <a href={`${PLAYGROUND}samples/`}>example apps</a> for the screen closest to yours, or read <a href={`${DOCS}get_started/about`}>In a Nutshell</a> for how it works.</p>
    </div>
  </section>

  <section class="section alt" id="who-runs-it" aria-labelledby="h-who">
    <div class="wrap">
      <p class="kicker">Who runs it</p>
      <h2 id="h-who">In production, in the open, since 2023</h2>
      <p class="intro">Two companies run it in production and say so here; one offers training and certification for it. The project itself is public down to every change, so the figures below are not ours to make up.</p>
      <ul class="logos">{companies.map(([name, href, tag, text]) => <li><a href={href}>{name}</a><small>{tag}</small><span>{text}</span></li>)}</ul>
      <ul class="facts">{facts.map(([b, t]) => <li><b>{b}</b><span>{t}</span></li>)}</ul>
      <h3 class="refs-title">Talks, articles and videos</h3>
      <ul class="refs">{references.map(([year, title, where, href]) => <li><time>{year}</time><a href={href}>{title}</a><small>{where}</small></li>)}</ul>
      <details class="refs-more">
        <summary>{moreReferences.length} more, 2023 to 2026</summary>
        <ul class="refs">{moreReferences.map(([year, title, where, href]) => <li><time>{year}</time><a href={href}>{title}</a><small>{where}</small></li>)}</ul>
      </details>
      <p class="more">→ Running abap2UI5, or written about it? <a href={`${GITHUB_PAGE}/edit/main/src/pages/index.astro`}>Add your row</a>, or write to <a href={`mailto:${MAIL}`}>{MAIL}</a>. The figures: <a href={GITHUB}>the repository</a> and its <a href={`${GITHUB}/releases`}>releases</a>.</p>
    </div>
  </section>

  <section class="section" id="when-to-use-it-and-when-not" aria-labelledby="h-fit">
    <div class="wrap">
      <p class="kicker">Compared with the market</p>
      <h2 id="h-fit">Where it is the shorter path, and where it is not</h2>
      <p class="intro">SAP's own routes and the UI5 app platforms and low-code builders sold on top of SAP, side by side. The last three rows are where abap2UI5 is not ahead.</p>
      <div class="table compare">
        <table>
          <thead><tr><th scope="col"></th><th scope="col" class="us">abap2UI5</th>{rivals.map((r) => <th scope="col">{r}</th>)}</tr></thead>
          <tbody>{compare.map(([k, a, b, c, d, even]) => (
            <tr>
              <th scope="row">{k}</th>
              <td class={even ? "us even" : "us"} data-th="abap2UI5">{a}</td>
              {[b, c, d].map((t, i) => <td data-th={rivals[i]}>{t}</td>)}
            </tr>
          ))}</tbody>
        </table>
      </div>
      <div class="fit">
        <div class="yes">
          <h3>Where teams choose abap2UI5</h3>
          <ul class="reasons">{useIt.map(([b, t]) => <li><b>{b}</b>{t}</li>)}</ul>
        </div>
        <div class="no">
          <h3>Where something else fits better</h3>
          <ul class="reasons">{notIt.map(([b, t]) => <li><b>{b}</b>{t}</li>)}</ul>
        </div>
      </div>
      <p class="more">→ <a href={`${DOCS}advanced/insights/30-on-stack-or-side-by-side`}>On-Stack or Side-by-Side</a> and <a href={`${DOCS}advanced/insights/31-one-app-many-systems`}>One App, Many Systems</a> are the deployment scenarios in detail.</p>
    </div>
  </section>

  <section class="section alt" id="what-you-keep" aria-labelledby="h-keep">
    <div class="wrap">
      <p class="kicker">Governance and security</p>
      <h2 id="h-keep">An app is ABAP code, and is governed like it</h2>
      <p class="intro">One ABAP class per app, no generated artifacts, no tables that describe a screen. So every rule that already applies to ABAP, from code review to the four-eyes principle on transports, applies to an app without any change. A system closed for repository changes is closed for abap2UI5 apps.</p>
      <div class="table">
        <table>
          <thead><tr><th scope="col"></th><th scope="col" class="us">abap2UI5</th><th scope="col">A tool that stores apps as configuration</th></tr></thead>
          <tbody>{keep.map(([k, a, b]) => <tr><th scope="row">{k}</th><td class="us" data-th="abap2UI5">{a}</td><td data-th="A tool that stores apps as configuration">{b}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="cards five">
        {governance.map(([icon, h, t]) => <div class="card"><Icon name={icon} /><h3>{h}</h3><p>{t}</p></div>)}
      </div>
      <p class="callout"><b>No shadow IT.</b> There is no click-together designer that bypasses your development process: every app is a class, governed by the rules you already have.</p>
