const addons = [
  ["selection-screen", "Selection screens and variants"],
  ["table-maintenance", "Table maintenance in your browser"],
  ["layout-management", "Customizable table and form layouts with persistent variants"],
  ["popups", "Value help, search help, transport selection"],
