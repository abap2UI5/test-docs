---
/* abap2UI5 for decision makers - IT management, product owners, architecture
 * boards: what it lets you build, why it beats every other way to put a UI5
 * app on SAP (commercial products included), what it costs and how to start.
 *
 * THE SECTION IDS ARE ADDRESSES. /docs/evaluate redirects here with its
 * #fragment, and the framework's README links #what-you-keep and
 * #when-to-use-it-and-when-not; test/site.test.mjs names all eight, so a
 * renamed id is a failing build, not a dead link. */
import Page from "../layouts/Page.astro";
import Stats from "../components/Stats.astro";
import Icon from "../components/Icon.astro";
import CostCalculator from "../components/CostCalculator.astro";

const DOCS = "https://abap2ui5.github.io/docs/";
const PLAYGROUND = "https://abap2ui5.github.io/playground/";
const GITHUB = "https://github.com/abap2UI5/abap2UI5";
const GITHUB_PAGE = "https://github.com/abap2UI5/test-docs";
const base = import.meta.env.BASE_URL;

/* What it solves - the processes, not one problem. The same ground the
 * commercial SAP app platforms sell (warehouse, maintenance, shop floor,
 * approvals), at no license fee. */
const useCases = [
  ["box", "Warehouse & logistics", "Goods receipt, picking, stock transfers and inventory counts on scanners, handhelds and tablets - in the browser, with the barcode scanner and camera of the device.", "z2ui5_cl_smp_app_530", "A scan field for the warehouse: every scan lands in the list, no tap needed"],
  ["wrench", "Maintenance & service", "Work orders, notifications and checklists for technicians, on the desktop in the workshop or on the phone at the machine.", "z2ui5_cl_smpc_app_089", "An object page: header, status and sections, as a work order would show them"],
  ["factory", "Production & shop floor", "Confirmations, quality inspections, shift plans and the special processes the standard never covered - right where the work happens.", "z2ui5_cl_smpc_app_108", "A planning calendar, as a shift or capacity plan would use it"],
  ["check", "Approvals & workflows", "Purchase requisitions, invoices, leave and master-data requests: approve in one click, in the launchpad, in Teams or on the phone.", "z2ui5_cl_smpc_app_291", "A notification inbox with priorities and actions"],
  ["gauge", "Cockpits & dashboards", "KPIs, charts and monitors for one team or one process, live from SAP - no data warehouse, no extra BI tool.", "z2ui5_cl_smpc_app_517", "Launchpad tiles with KPIs, trends and figures"],
  ["form", "Paper & Excel replaced", "Forms, checklists and spreadsheets that live outside SAP become apps that write straight into it.", "z2ui5_cl_smpc_app_329", "A form with an edit switch, instead of a paper form"],
  ["list", "SAP GUI modernized", "Reports, ALV lists and transactions turn into browser apps one at a time, with the logic behind them unchanged.", "z2ui5_cl_smp_app_070", "An ALV-style table with search, sort, filter and row actions"],
  ["phone", "Mobile, without an app store", "Every app runs on iOS and Android in the browser or the mobile shell - nothing to install, nothing to distribute.", "z2ui5_cl_smpc_app_024", "A feed app on a phone"],
];
const useIt = [
  ["The team is ABAP.", "No JavaScript, no UI5 tooling, no Business Application Studio to set up. An app is one class, written, debugged, transported and unit-tested like every other class."],
  ["The system is older than RAP.", "NetWeaver 7.02 to 7.4x have no RAP and a Fiori stack that is expensive to add. abap2UI5 runs there from the same source it runs on ABAP Cloud, so an app written on 7.31 today moves to S/4HANA unchanged."],
  ["The screen is yours, not SAP's.", "Tools, cockpits, monitors, admin consoles, anything that used to be a report or a module pool. The moment a screen is a dashboard with a chart and a custom form, a Fiori Elements template becomes the thing you fight."],
  ["You do not want a deployment pipeline.", "No BSP upload, no approuter, no MTA. The ABAP system serves the frontend; an abapGit pull is the installation."],
  ["You replace SAP GUI screens one at a time.", "Selection screens, lists and transactions become browser apps without rewriting the logic behind them."],
];
/* The market, as a manager compares it. Columns: abap2UI5, then SAP's own
 * two routes, then the commercial UI5 app platforms and low-code builders
 * sold on top of SAP. */
const rivals = ["RAP + Fiori Elements", "Freestyle UI5 + OData", "Commercial UI5 & low-code platforms"];
const compare = [
  ["License cost", "None. MIT, for any number of users, systems and apps", "Part of the SAP license", "Part of the SAP license", "Subscription or per-user fees, renewed every year"],
  ["Who builds the apps", "The ABAP team you already have", "ABAP plus CDS, RAP and annotation specialists", "JavaScript / UI5 developers", "Developers trained on the vendor's tool"],
  ["First screen", "Minutes", "Days: model, service, project, deployment", "Days to weeks", "After the platform is installed and licensed"],
  ["Freedom of the UI", "Every UI5 control, any layout", "SAP's floorplans and their extension points", "Every UI5 control", "What the vendor's designer offers"],
  ["Older SAP releases", "NetWeaver 7.02 up to ABAP Cloud, one source", "7.5x and later", "Yes, with OData effort per release", "Depends on the vendor's add-on"],
  ["Extra infrastructure", "None - one endpoint on your SAP system", "Fiori frontend server and deployment", "Frontend deployment (BSP, BTP or web server)", "The vendor's add-on, server or cloud tenant"],
  ["Lock-in", "None - apps are plain ABAP classes in your system", "SAP's programming model", "Low", "Apps live in the vendor's runtime and repository"],
  ["Source code", "Open, every line, on GitHub", "Closed", "UI5 open, your app yours", "Closed"],
  ["Built with AI", "One class an AI writes whole - AI Studio, Claude Code and Copilot plugins, free", "Many artifacts for an AI to generate and keep in sync", "Two codebases, frontend and service", "The vendor's own AI, at the vendor's price"],
];
/* Why AI and abap2UI5 fit: one class is one file an assistant can write
 * whole, check without a system and hand over for review. Every claim is in
 * the framework README's "Build with AI" and "AI Assistants". */
const ai = [
  ["spark", "One app, one file", "An AI writes the whole app - one ABAP class. No OData service, no frontend project, no deployment to generate and keep in sync."],
  ["play", "From a sentence to an app", "The AI Studio builds an app from a description, right in the browser: written, run and fixed against the real framework, ready for abapGit. Nothing to install."],
  ["code", "In the tools your team uses", "Plugins for Claude Code and GitHub Copilot, skills for any agent and an MCP server that validates, runs and screenshots apps - without an SAP system."],
  ["list", "Learns from 700+ samples", "Hundreds of working apps and documentation written for AI make the result right the first time, not the third."],
  ["check", "Checked before anyone looks", "The abap2UI5 linter tests every class the AI writes, and the AI fixes what it broke before a developer reviews it."],
  ["chat", "AI inside your apps, too", "A chat or a summarize-this-data panel in an existing app, with a local model first or the provider of your choice."],
];
/* abap2UI5 against a platform that stores apps as configuration - the
 * commercial UI5 builders and low-code tools work that way. */
const keep = [
  ["What an app is", "An ABAP class", "Entries in the tool's tables, read by its runtime"],
  ["Where a change is made", "In the development system, in ADT or SE80", "Wherever the tool's designer is open, possibly production"],
  ["How a change travels", "A transport, like any class", "The tool's own export, or a customizing transport"],
  ["How a change is reviewed", "As a code diff: in abapGit, a pull request or the transport", "In the tool's designer, if it shows a history at all"],
  ["What a debugger shows", "Your code", "The tool's runtime interpreting your configuration"],
  ["What happens if the tool goes away", "The classes stay; they are plain ABAP in your system", "The apps go with it"],
];
const strings = [
  ["No license, now or later", "MIT. No license key, no subscription, no fee per user, per app or per system - and nothing to renew."],
  ["Nothing to sign up for", "The playground runs in the browser with no account. The framework is an abapGit pull; there is no trial period and no demo to book."],
  ["No runtime in between", "An app is a class and runs as ABAP. The framework itself is ABAP source in your system, readable to the last line."],
  ["No extra platform", "No BTP subscription, no middleware, no server of its own. One ICF node on the system you already run."],
  ["The tools you already use", "ADT, SE80, abapGit, ATC, abaplint, ABAP Unit, the debugger and your AI assistant work on an app as on any other class."],
  ["Every UI5 control", "Any control of the UI5 release your system runs, 1:1 from ABAP - the whole library, not a selection."],
  ["Free to leave", "The apps stay ordinary classes. A build renamed into your own namespace is one workflow run, and the source is yours to fork."],
  ["Built in the open", "Every issue, every release, the backlog and every test that holds the code are public on GitHub."],
];
const governance = [
  ["lock", "Authentication is SAP's", "No user store, no token, no session concept of its own. A request that reaches an app has passed SAP logon."],
  ["key", "Authorization is two gates", "The authorization object on the ICF node, as for any service, and the app's own authority checks in its code, the same way a transaction or a report does them. The framework adds no central check on purpose."],
  ["db", "Data changes are your code's", "An app posts a document by calling the same BAPIs, function modules or RAP actions any other ABAP program calls, so change documents, application logs and the authority checks behind them apply unchanged."],
  ["log", "Every roundtrip can be logged", "A monitor interface receives, for each request, the user, the app, the event, the timings and any error. It is off until an installation switches it on."],
  ["leaf", "Clean core", "abap2UI5 uses released APIs only, passes the ABAP Cloud checks and runs in ABAP Cloud, on S/4HANA and on BTP, from the same source that runs on NetWeaver 7.02. It modifies nothing in the SAP standard."],
];
const objections = [
  ["It is an open-source project. What if the maintainers stop?", `The installed version keeps running, the source is in your system in full, readable and changeable, and the apps stay ordinary ABAP classes. Nothing is called at runtime that is not in your system, apart from the UI5 library, which you can host yourself. A build renamed into your own namespace is one workflow run (<a href="${DOCS}advanced/renaming">Namespaces, Renaming</a>).`],
  ["Is this another UI5 wrapper that will not survive the next UI5 release?", `The frontend is UI5 itself, not a copy of it, and every merge is run in the browser on the oldest supported release and on UI5 2.x. Releases are tagged and listed (<a href="${DOCS}resources/changelog">Release Notes</a>); what is on its way out is announced and tracked until removal (<a href="${DOCS}resources/deprecations">Deprecations</a>), and the public API apps use is held by a snapshot, so a change to it fails the framework's own pull request.`],
  ["Every click is a roundtrip. Is that fast enough?", `A roundtrip is one HTTP POST carrying only what changed, served by the ABAP stack that already serves everything else. For the screens this page is about, worklists, forms, cockpits, it is the same round trip a SAP GUI screen makes, in a browser. What it is not built for is a real-time collaborative editor or an app that holds its state offline (<a href="${DOCS}configuration/performance">Performance</a>).`],
  ["Our clean-core guideline names RAP. Where does this leave us?", "Side by side. abap2UI5 passes the ABAP Cloud checks and modifies nothing in the standard, so it is clean core in the technical sense, but it is not SAP's programming model. The usual outcome is a scope: standard transactional screens in RAP, the tools around them in abap2UI5, both in one launchpad."],
  ["Why should we trust it over a product we pay for?", "Because you can check everything a vendor asks you to believe. The source is open, every test is public, and an app is a class in your own system that keeps running whatever happens to the project. A paid platform sells you a runtime you cannot read and a contract you have to renew; abap2UI5 hands you the code."],
  ["Who is accountable when something breaks?", `Your developer, for the app, the same as for any class in the system; the community, for the framework, on a best-effort basis; a commercial partner, if you sign one. Security reports are acknowledged within three business days (<a href="${DOCS}configuration/security">Security</a>).`],
  ["Is anybody actually running this in production?", `Yes, see below. And every release is tested against Standard ABAP and ABAP Cloud, downported and linted against NetWeaver 7.02, and run in the browser on the oldest and the newest supported UI5 release (<a href="${GITHUB}/blob/main/docs/verified-on.md">verified on</a>).`],
];
const companies = [
  ["Emineo", "https://emineo.ch/", "ABAP 7.57", "Apps for EWM and PP, running on desktop and mobile devices"],
  ["Swiss Krono", "https://www.swisskrono.com/", "ABAP 7.55", "Apps for EWM, running on mobile devices"],
  ["Nuve Platform", "https://www.nuveplatform.com", "Integration", "On-demand SAP systems with automated abap2UI5 setups"],
  ["Logali Group", "https://logaligroup.com", "Training", "Webinars and certifications for abap2UI5"],
];
/* Every talk, article and video, newest first - the full list, which used
 * to be the manual's References page. */
const references = [
