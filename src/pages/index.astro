];

/* Governance: an app is an ABAP class, against a tool that stores apps as
 * configuration, which is how the commercial builders work. */
const keep = [
  ["What an app is", "An ABAP class", "Entries in the tool's tables, read by its runtime"],
  ["Where a change is made", "In the development system, in the ABAP tools", "Wherever the tool's designer is open, possibly production"],
  ["How a change travels", "A transport, like any class", "The tool's own export, or a customizing transport"],
  ["What happens if the tool goes away", "The classes stay; they are plain ABAP in your system", "The apps go with it"],
];
const governance = [
  ["lock", "Logon is SAP's", "No user store, no token, no session of its own: a request that reaches an app has passed SAP logon."],
  ["key", "Authorizations are SAP's", "The authorization on the service endpoint, and the app's own checks in its code, as a transaction does them."],
  ["db", "Data changes are your code's", "An app posts through the same BAPIs, function modules or RAP actions as any program, so change documents and application logs apply unchanged."],
  ["log", "Every request can be logged", "A monitor records, per request, user, app, event, timings and any error. Off until an installation switches it on."],
