];
const strings = [
  ["Nothing to sign up for", "The examples run in the browser with no account. The framework is an abapGit pull; no trial period, no demo to book."],
  ["No extra platform", "No BTP subscription, no middleware, no server of its own: one service endpoint on your system."],
  ["Free to leave", "The apps stay ordinary classes, and the skill your team invests in is ABAP, the one it keeps whatever the next UI technology is. A build renamed into your own namespace is one workflow run."],
  ["Built in the open", "Every issue, every release and the backlog are public on GitHub."],
];

/* AI: one class is one file an assistant can write whole and a reviewer can
